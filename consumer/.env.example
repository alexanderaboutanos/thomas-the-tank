# Copy to .env and fill from `terraform output` in ../confluent. The live-tap
# consumer authenticates as the app-live service account — read-only: topic READ,
# consumer-group READ on the "sodor-live-" prefix, and SR DeveloperRead.

# Kafka cluster (shared endpoint) + the live consumer's own key pair.
BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
LIVE_KAFKA_API_KEY=...                  # terraform output live_kafka_api_key
LIVE_KAFKA_API_SECRET=...               # terraform output -raw live_kafka_api_secret

# Schema Registry (shared URL) + the live consumer's own SR key pair.
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.region.provider.confluent.cloud
LIVE_SCHEMA_REGISTRY_API_KEY=...        # terraform output live_schema_registry_api_key
LIVE_SCHEMA_REGISTRY_API_SECRET=...     # terraform output -raw live_schema_registry_api_secret

TOPIC=sodor-telemetry
GROUP_ID=sodor-live-consumer            # MUST start with "sodor-live-" (the ACL prefix)
HEARTBEAT_SECONDS=20                    # SSE keep-alive cadence for quiet engines
PORT=8000
