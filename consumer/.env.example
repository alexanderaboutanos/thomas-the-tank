# Copy to .env and fill from `terraform output` in ../confluent. The live-tap
# consumer authenticates as the app-live service account — read-only: topic READ,
# consumer-group READ on the "sodor-live-" prefix, and SR DeveloperRead.

# Kafka cluster (shared endpoint) + the live consumer's own key pair.
BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
LIVE_KAFKA_API_KEY=...                  # terraform output live_kafka_api_key
LIVE_KAFKA_API_SECRET=...               # terraform output -raw live_kafka_api_secret

# Schema Registry (shared URL) + the live consumer's own SR key pair.
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.region.provider.confluent.cloud
LIVE_SCHEMA_REGISTRY_API_KEY=...        # terraform output live_schema_registry_api_key
LIVE_SCHEMA_REGISTRY_API_SECRET=...     # terraform output -raw live_schema_registry_api_secret

TOPIC=sodor-telemetry
GROUP_ID=sodor-live-consumer            # MUST start with "sodor-live-" (the ACL prefix)
HEARTBEAT_SECONDS=20                    # SSE keep-alive cadence for quiet engines
PORT=8000

# ─── Folded serving routes (serving.py): /produce, /latest, /query ────────────
# Only needed to exercise those routes locally; the live SSE consumer above runs
# without them. In the cloud the ECS task injects all of these from Secrets
# Manager (see infra/ecs.tf), so they live here only for local dev.

# /produce writes to Kafka, so it needs the PRODUCER service account's keys (WRITE),
# NOT the read-only app-live keys above. BOOTSTRAP_SERVERS, SCHEMA_REGISTRY_URL and
# TOPIC are shared (same cluster) — reused from above.
PRODUCE_KAFKA_API_KEY=...               # producer SA — confluent: terraform output kafka_api_key
PRODUCE_KAFKA_API_SECRET=...            # confluent: terraform output -raw kafka_api_secret
PRODUCE_SCHEMA_REGISTRY_API_KEY=...     # confluent: terraform output schema_registry_api_key
PRODUCE_SCHEMA_REGISTRY_API_SECRET=...  # confluent: terraform output -raw schema_registry_api_secret

# /latest + /query read Snowflake via the connector key-pair user (full PEM, with
# real newlines). Mirrors the sodor-railway/snowflake secret.
SNOWFLAKE_ACCOUNT=<org>-<account>
SNOWFLAKE_USER=SODOR_CONNECTOR
SNOWFLAKE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…full PEM…\n-----END PRIVATE KEY-----\n"
SNOWFLAKE_WAREHOUSE=SODOR_WH
SNOWFLAKE_DATABASE=SODOR_RAILWAY
SNOWFLAKE_SCHEMA=TELEMETRY
SNOWFLAKE_ROLE=SODOR_CONNECTOR_ROLE
NUM_ENGINES=5                          # how many engines /produce emits per tick
MIN_PRODUCE_INTERVAL_SECONDS=1.0       # min gap between produce ticks; caps a /produce flood

# ─── Kinesis backend (the swappable second stream) ────────────────────────────
# OPTIONAL: leave both unset to run Kafka-only — the Kinesis consumer simply
# never starts. Unlike every other credential here, Kinesis auth is NOT a key:
# boto3 reads the AMBIENT credential chain — your `AWS_PROFILE` locally, the ECS
# task role in the cloud (IAM-scoped to the stream ARN). So set AWS_PROFILE in
# your shell (e.g. `export AWS_PROFILE=personal`), not in this file.
AWS_REGION=us-east-2                    # region of the Kinesis stream (boto3 endpoint)
KINESIS_STREAM_NAME=sodor-railway-telemetry   # `terraform output kinesis_stream_name`
