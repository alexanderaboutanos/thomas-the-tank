# Copy to .env and fill in. Get these from the Confluent Cloud console
# after creating a cluster + a cluster API key.
BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
KAFKA_API_KEY=your-cluster-api-key
KAFKA_API_SECRET=your-cluster-api-secret

# Schema Registry (Stream Governance). Separate credential pair from the Kafka
# key — get these from `terraform output` in /confluent.
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.region.provider.confluent.cloud
SCHEMA_REGISTRY_API_KEY=your-sr-api-key
SCHEMA_REGISTRY_API_SECRET=your-sr-api-secret

TOPIC=sodor-telemetry
NUM_ENGINES=5
INTERVAL_SECONDS=2
